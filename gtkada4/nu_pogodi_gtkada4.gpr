with "config/nu_pogodi_gtkada4_config.gpr";

project Nu_Pogodi_GtkAda4 is

   for Source_Dirs use ("source");
   for Object_Dir use ".objs";
   for Exec_Dir use "../bin";
   for Main use ("nu_pogodi-driver.adb");

   package Builder is
      for Executable ("nu_pogodi-driver.adb") use "nu_pogodi_gtkada4";
   end Builder;

   package Compiler is
      for Switches ("Ada") use Nu_Pogodi_GtkAda4_Config.Ada_Compiler_Switches;
   end Compiler;

end Nu_Pogodi_GtkAda4;
