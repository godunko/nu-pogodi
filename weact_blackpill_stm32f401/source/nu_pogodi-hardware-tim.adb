pragma Ada_2022;

with System.Storage_Elements;

with A0B.ARMv7M.NVIC_Utilities;
with A0B.STM32F401.SVD.DMA;
with A0B.STM32F401.SVD.RCC;
with A0B.STM32F401.SVD.TIM;
with A0B.Types;

package body Nu_Pogodi.Hardware.TIM is

   procedure Configure_TIM1;

   procedure Configure_TIM4;

   procedure Configure_DMA;

   procedure DMA2_Stream4_Handler
     with Export, Convention => C, External_Name => "DMA2_Stream4_Handler";

   Transmit_Descriptor : access A0B.Asynchronous_Transfers.Transfer_Descriptor;
   Transmit_Finished   : aliased A0B.Callbacks.Callback;

   -------------------
   -- Configure_DMA --
   -------------------

   procedure Configure_DMA is
   begin
      --  TIM is configured in burst mode, thus DMA must be configured in FIFO
      --  mode too. FIFO size should be multiple of the TIM burst size.

      A0B.STM32F401.SVD.DMA.DMA2_Periph.S4CR :=
        (@ with delta
           CHSEL => 2#110#,
           --  110: channel 6 selected: TIM1_CH4/TIM1_TRIG/TIM1_COM
           MBURST => 2#00#,   --  00: single transfer
           PBURST => 2#00#,   --  00: single transfer
           DBM    => False,   --  0: No buffer switching at the end of transfer
           PL     => 2#11#,   --  11: Very high
           MSIZE  => 2#01#,   --  01: half-word (16-bit)
           PSIZE  => 2#01#,   --  01: Half-word (16-bit)
           MINC   => True,
           --  1: Memory address pointer is incremented after each data
           --  transfer (increment is done according to MSIZE)
           PINC   => False,   --  0: Peripheral address pointer is fixed
           CIRC   => False,   --  0: Circular mode disabled
           DIR    => 2#01#,   --  01: Memory-to-peripheral
           PFCTRL => False,   --  0: The DMA is the flow controller
           TCIE   => True,    --  1: TC interrupt enabled
           HTIE   => False,   --  0: HT interrupt disabled
           TEIE   => False,   --  0: TE interrupt disabled
           DMEIE  => False,   --  0: DME interrupt disabled
           EN     => False);  --  0: Stream disabled
      A0B.STM32F401.SVD.DMA.DMA2_Periph.S4PAR :=
        A0B.Types.Unsigned_32
          (System.Storage_Elements.To_Integer
             (A0B.STM32F401.SVD.TIM.TIM1_Periph.DMAR'Address));
      A0B.STM32F401.SVD.DMA.DMA2_Periph.S4FCR :=
        (@ with delta
           FEIE  => False,   --  0: FE interrupt disabled
           DMDIS => True,    --  1: Direct mode disabled
           FTH   => 2#11#);  --  11: full FIFO

      --  Clear all flags, clear pending interrupt requests, and enable
      --  interrupt.

      A0B.STM32F401.SVD.DMA.DMA2_Periph.HIFCR :=
        (CTCIF4  => True,
         CHTIF4  => True,
         CTEIF4  => True,
         CDMEIF4 => True,
         CFEIF4  => True,
         others  => <>);
      A0B.ARMv7M.NVIC_Utilities.Clear_Pending (A0B.STM32F401.DMA2_Stream4);
      A0B.ARMv7M.NVIC_Utilities.Enable_Interrupt (A0B.STM32F401.DMA2_Stream4);
   end Configure_DMA;

   --------------------
   -- Configure_TIM1 --
   --------------------

   procedure Configure_TIM1 is
   begin
      A0B.STM32F401.SVD.TIM.TIM1_Periph.CR1 :=
        (@ with delta
           ARPE => True,    --  1: TIMx_ARR register is buffered
           CMS  => 2#00#,
           --  00: Edge-aligned mode. The counter counts up or down
           --  depending on the direction bit (DIR).
           DIR  => False,   --  0: Counter used as upcounter
           OPM  => False,   --  0: Counter is not stopped at update event
           URS  => False,
           --  0: Any of the following events generate an update interrupt or
           --  DMA request if enabled.
           --
           --  These events can be:
           --  – Counter overflow/underflow
           --  – Setting the UG bit
           --  – Update generation through the slave mode controller
           UDIS => False,
           --  0: UEV enabled. The Update (UEV) event is generated by one of
           --  the following events:
           --
           --  – Counter overflow/underflow
           --  – Setting the UG bit
           --  – Update generation through the slave mode controller
           --
           --  Buffered registers are then loaded with their preload values.
           CEN  => False);  --  0: Counter disabled
      A0B.STM32F401.SVD.TIM.TIM1_Periph.CR2 :=
        (@ with delta
           OIS1 => False,
           --  0: OC1=0 (after a dead-time if OC1N is implemented) when MOE=0
           CCPC => False);  --  0: CCxE, CCxNE and OCxM bits are not preloaded
      A0B.STM32F401.SVD.TIM.TIM1_Periph.SMCR :=
        (@ with delta
           MSM  => False,  --  0: No action
           TS   => 2#011#,  --  011: Internal Trigger 3 (ITR3): TIM4_TRGO
           SMS  => 2#110#);
           --  110: Trigger Mode - The counter starts at a rising edge of
           --  the trigger TRGI (but it is not reset). Only the start of
           --  the counter is controlled.
      A0B.STM32F401.SVD.TIM.TIM1_Periph.DIER :=
        (@ with delta
           TDE   => True,    --  1: Trigger DMA request enabled.
           COMDE => False,   --  0: COM DMA request disabled
           CC4DE => False,   --  0: CC4 DMA request disabled
           CC3DE => False,   --  0: CC3 DMA request disabled
           CC2DE => False,   --  0: CC2 DMA request disabled
           CC1DE => False,   --  0: CC1 DMA request disabled
           UDE   => False,   --  0: Update DMA request disabled
           BIE   => False,   --  0: Break interrupt disabled
           TIE   => False,   --  0: Trigger interrupt disabled
           COMIE => False,   --  0: COM interrupt disabled
           CC4IE => False,   --  0: CC4 interrupt disabled
           CC3IE => False,   --  0: CC3 interrupt disabled
           CC2IE => False,   --  0: CC2 interrupt disabled
           CC1IE => False,   --  0: CC1 interrupt disabled
           UIE   => False);  --  0: Update interrupt disabled
      A0B.STM32F401.SVD.TIM.TIM1_Periph.CCMR1_Output :=
        (@ with delta
           OC1CE => False,   --  0: OC1Ref is not affected by the ETRF Input
           OC1M  => 2#110#,
           --  110: PWM mode 1 - In upcounting, channel 1 is active as long as
           --  TIMx_CNT<TIMx_CCR1 else inactive. In downcounting, channel 1 is
           --  inactive (OC1REF=‘0) as long as TIMx_CNT>TIMx_CCR1 else active
           --  (OC1REF=1).
           OC1PE => True,
           --  1: Preload register on TIMx_CCR1 enabled. Read/Write operations
           --  access the preload register. TIMx_CCR1 preload value is loaded
           --  in the active register at each update event.
           OC1FE => False,
           --  0: CC1 behaves normally depending on counter and CCR1 values
           --  even when the trigger is ON. The minimum delay to activate
           --  CC1 output when an edge occurs on the trigger input is 5
           --  clock cycles.
           CC1S  => 2#00#);  --  00: CC1 channel is configured as output
      A0B.STM32F401.SVD.TIM.TIM1_Periph.CCER :=
        (@ with delta
           CC1NP => False,  --  0: OC1N active high.
           CC1NE => False,
           --  0: Off - OC1N is not active. OC1N level is then function of MOE,
           --  OSSI, OSSR, OIS1, OIS1N and CC1E bits.
           CC1P  => False,
           --  00: non-inverted/rising edge
           --
           --  The circuit is sensitive to TIxFP1 rising edge (capture or
           --  trigger operations in reset, external clock or trigger mode),
           --  TIxFP1 is not inverted (trigger operation in gated mode or
           --  encoder mode).
           CC1E => True);
           --  1: On - OC1 signal is output on the corresponding output pin
           --  depending on MOE, OSSI, OSSR, OIS1, OIS1N and CC1NE bits.
      A0B.STM32F401.SVD.TIM.TIM1_Periph.PSC.PSC := 79;
      --  Prescaler value
      A0B.STM32F401.SVD.TIM.TIM1_Periph.ARR.ARR := 999;
      --  Auto-reload value
      A0B.STM32F401.SVD.TIM.TIM1_Periph.RCR.REP := 0;
      --  Repetition counter value
      A0B.STM32F401.SVD.TIM.TIM1_Periph.CCR1.CCR1 := 0;
      --  Capture/Compare 1 value
      A0B.STM32F401.SVD.TIM.TIM1_Periph.BDTR :=
        (@ with delta
           MOE  => True,
           --  1: OC and OCN outputs are enabled if their respective enable
           --  bits are set (CCxE, CCxNE in TIMx_CCER register).
           AOE  => False,   --  0: MOE can be set only by software
           BKE  => False,
           --  0: Break inputs (BRK and CSS clock failure event) disabled
           LOCK => 2#00#);  --  00: LOCK OFF - No bit is write protected.
      A0B.STM32F401.SVD.TIM.TIM1_Periph.DCR :=
        (@ with delta
           DBL => 3,    --  TIM1_ARR .. TIM1_CCR2
           DBA => 11);  --  TIM1_ARR

      A0B.STM32F401.SVD.TIM.TIM1_Periph.EGR := (UG => True, others => <>);
      --  1: Reinitialize the counter and generates an update of the registers.
      --  Note that the prescaler counter is cleared too (anyway the prescaler
      --  ratio is not affected). The counter is cleared if the center-aligned
      --  mode is selected or if DIR=0 (upcounting), else it takes the
      --  auto-reload value (TIMx_ARR) if DIR=1 (downcounting).

      A0B.STM32F401.SVD.TIM.TIM1_Periph.SR :=
        (@ with delta
           CC4OF => False,
           CC3OF => False,
           CC2OF => False,
           CC1OF => False,
           BIF   => False,
           TIF   => False,
           COMIF => False,
           CC4IF => False,
           CC3IF => False,
           CC2IF => False,
           CC1IF => False,
           UIF   => False);
      --  Clear all flags.

      A0B.STM32F401.SVD.TIM.TIM1_Periph.CR1.CEN := True;
      --  Run TIM1
   end Configure_TIM1;

   --------------------
   -- Configure_TIM4 --
   --------------------

   procedure Configure_TIM4 is
   begin
      A0B.STM32F401.SVD.TIM.TIM4_Periph.CR1 :=
        (@ with delta
           ARPE => False,   --  0: TIMx_ARR register is not buffered
           CMS  => 2#00#,
           --  00: Edge-aligned mode. The counter counts up or down depending
           --  on the direction bit (DIR).
           DIR  => False,   --  0: Counter used as upcounter
           OPM  => False,   --  0: Counter is not stopped at update event
           URS  => True,
           --  1: Only counter overflow/underflow generates an update interrupt
           --  or DMA request if enabled.
           UDIS => False,
           --  0: UEV enabled. The Update (UEV) event is generated by one of
           --  the following events:
           --
           --  – Counter overflow/underflow
           --  – Setting the UG bit
           --  – Update generation through the slave mode controller
           --
           --  Buffered registers are then loaded with their preload values.
           CEN  => False);  --  0: Counter disabled
      A0B.STM32F401.SVD.TIM.TIM4_Periph.CR2 :=
        (@ with delta
           MMS => 2#010#);
           --  010: Update - The update event is selected as trigger output
           --  (TRGO). For instance a master timer can then be used as a
           --  prescaler for a slave timer.
      A0B.STM32F401.SVD.TIM.TIM4_Periph.DIER :=
        (@ with delta
           TDE   => False,   --  0: Trigger DMA request disabled
           CC4DE => False,   --  0: CC4 DMA request disabled
           CC3DE => False,   --  0: CC3 DMA request disabled
           CC2DE => False,   --  0: CC2 DMA request disabled
           CC1DE => False,   --  0: CC1 DMA request disabled
           UDE   => False,   --  0: Update DMA request disabled
           TIE   => False,   --  0: Trigger interrupt disabled
           CC4IE => False,   --  0: CC4 interrupt disabled
           CC3IE => False,   --  0: CC3 interrupt disabled
           CC2IE => False,   --  0: CC2 interrupt disabled
           CC1IE => False,   --  0: CC1 interrupt disabled
           UIE   => False);  --  0: Update interrupt disabled
      A0B.STM32F401.SVD.TIM.TIM4_Periph.PSC.PSC := 79;
      --  Prescaler value
      A0B.STM32F401.SVD.TIM.TIM4_Periph.ARR.ARR_L := 249;
      --  Auto-reload value

      A0B.STM32F401.SVD.TIM.TIM4_Periph.SR :=
        (@ with delta
           CC4OF => False,
           CC3OF => False,
           CC2OF => False,
           CC1OF => False,
           TIF   => False,
           CC4IF => False,
           CC3IF => False,
           CC2IF => False,
           CC1IF => False,
           UIF   => False);
      --  Clear all flags.
   end Configure_TIM4;

   --------------------------
   -- DMA2_Stream4_Handler --
   --------------------------

   procedure DMA2_Stream4_Handler is
   begin
      if A0B.STM32F401.SVD.DMA.DMA2_Periph.HISR.TCIF4 then
         A0B.STM32F401.SVD.DMA.DMA2_Periph.HIFCR :=
           (CTCIF4 => True, others => <>);

         A0B.Asynchronous_Transfers.Set_Success
           (Transmit_Descriptor.all, Transmit_Descriptor.Length);
         Transmit_Descriptor := null;
         A0B.Callbacks.Emit_Once (Transmit_Finished);

         if not A0B.STM32F401.SVD.DMA.DMA2_Periph.S4CR.EN then
            A0B.STM32F401.SVD.TIM.TIM4_Periph.CR1.CEN   := False;
            A0B.STM32F401.SVD.TIM.TIM1_Periph.CCR1.CCR1 := 0;
         end if;
      end if;
   end DMA2_Stream4_Handler;

   ----------------
   -- Initialize --
   ----------------

   procedure Initialize is
   begin
      A0B.STM32F401.SVD.RCC.RCC_Periph.APB2ENR.TIM1EN := True;
      A0B.STM32F401.SVD.RCC.RCC_Periph.APB1ENR.TIM4EN := True;
      A0B.STM32F401.SVD.RCC.RCC_Periph.AHB1ENR.DMA2EN := True;
      --  Don't need to do dummy read of ENR registers, order of writes
      --  guarantee that TIM1 will be enabled when all ENR are set, likewise
      --  DMA2 be enabled when it is time to configure it.

      Configure_TIM1;
      Configure_TIM4;
      Configure_DMA;
   end Initialize;

   --------------
   -- Transmit --
   --------------

   procedure Transmit
     (Descriptor : aliased in out
        A0B.Asynchronous_Transfers.Transfer_Descriptor;
      Finished   : A0B.Callbacks.Callback;
      Success    : in out Boolean)
   is
      use type System.Storage_Elements.Storage_Count;

   begin
      if not Success then
         return;
      end if;

      if Descriptor.Length = 0
        or Descriptor.Length mod 2 /= 0
        or Descriptor.Length / 2 >
          System.Storage_Elements.Storage_Count (A0B.Types.Unsigned_16'Last)
      then
         --  DMA transfers a nonzero count of 16-bit elements.

         Success := False;

         return;

      elsif A0B.STM32F401.SVD.DMA.DMA2_Periph.S4CR.EN then
         --  Transfer is in progress.

         Success := False;

         return;
      end if;

      A0B.Asynchronous_Transfers.Set_Active (Descriptor);

      Transmit_Descriptor := Descriptor'Unchecked_Access;
      Transmit_Finished   := Finished;

      A0B.STM32F401.SVD.DMA.DMA2_Periph.S4M0AR :=
        A0B.Types.Unsigned_32
          (System.Storage_Elements.To_Integer (Transmit_Descriptor.Buffer));
      A0B.STM32F401.SVD.DMA.DMA2_Periph.S4NDTR :=
        (NDT    => A0B.Types.Unsigned_16 (Transmit_Descriptor.Length / 2),
         others => <>);
      A0B.STM32F401.SVD.DMA.DMA2_Periph.S4CR.EN := True;

      if not A0B.STM32F401.SVD.TIM.TIM4_Periph.CR1.CEN then
         A0B.STM32F401.SVD.TIM.TIM4_Periph.EGR := (UG => True, others => <>);
         A0B.STM32F401.SVD.TIM.TIM4_Periph.CR1.CEN := True;
      end if;

      Success := True;
   end Transmit;

end Nu_Pogodi.Hardware.TIM;
