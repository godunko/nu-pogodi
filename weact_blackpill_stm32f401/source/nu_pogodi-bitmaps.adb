   function Metadata (Id : Bitmap_Id) return Bitmap_Descriptor is
     (Descriptors (Id));

   procedure Draw (Buffer : in out Framebuffer; Id : Bitmap_Id) is
      Bitmap : constant Bitmap_Descriptor := Descriptors (Id);
      Bitmap_Row_Bytes : constant Positive := Bitmap.Width / 8;
      Screen_Y, Screen_Byte : Integer;
      Target, Source : Natural;
   begin
      for Row in 0 .. Bitmap.Height - 1 loop
         Screen_Y := Bitmap.Y + Row;
         if Screen_Y >= 0 and then Screen_Y < Screen_Height then
            for Column in 0 .. Bitmap_Row_Bytes - 1 loop
               Screen_Byte := Bitmap.X / 8 + Column;
               if Screen_Byte >= 0 and then Screen_Byte < Row_Bytes then
                  Target := Screen_Y * Row_Bytes + Screen_Byte;
                  Source := Row * Bitmap_Row_Bytes + Column;
                  Buffer (Target) := Buffer (Target) and Bitmap.Data (Source);
               end if;
            end loop;
         end if;
      end loop;
   end Draw;

   procedure Reconstruct (Buffer : out Framebuffer) is
   begin
      Buffer := [others => 16#FF#];
      for Id in Bitmap_Id loop
         Draw (Buffer, Id);
      end loop;
   end Reconstruct;
