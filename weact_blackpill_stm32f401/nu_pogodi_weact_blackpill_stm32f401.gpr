with "config/nu_pogodi_weact_blackpill_stm32f401_config.gpr";

project Nu_Pogodi_WeAct_BlackPill_STM32F401 is

   for Target use "arm-eabi";
   for Runtime ("Ada") use "runtime";

   for Object_Dir use ".objs";
   for Exec_Dir use "../bin";

   for Main use ("nu_pogodi-driver.adb");
   for Source_Dirs use ("source");

   package Compiler is
      for Switches ("Ada") use Nu_Pogodi_Weact_Blackpill_Stm32f401_Config.Ada_Compiler_Switches &
        ("-gnatyo");  --  check subprogram bodies in alphabetical order
   end Compiler;

   package Builder is
      for Executable ("nu_pogodi-driver.adb") use "nu_pogodi_weact_blackpill_stm32f401.elf";
   end Builder;

   package Linker is
      for Switches ("Ada") use ("-Wl,--gc-sections");
   end Linker;

end Nu_Pogodi_WeAct_BlackPill_STM32F401;
